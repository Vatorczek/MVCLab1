@model IEnumerable<Portfelik.Models.Expense>

@{
    ViewData["Title"] = "Lista wydatków";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Lista wydatków</h1>
        <a asp-action="Create" class="btn btn-success">+ Dodaj nowy wydatek</a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group" style="max-width: 400px;">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Szukaj po kategorii..."
                   value="@ViewData["CurrentFilter"]" />
            <button type="submit" class="btn btn-outline-secondary">Szukaj</button>
            <a asp-action="Index" class="btn btn-outline-danger">Wyczyść</a>
        </div>
    </form>

    <table class="table table-striped table-hover shadow-sm rounded">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Category)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Amount)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Date)
                </th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Category)</span>
                    </td>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.Amount) zł</strong>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Szczegóły</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light">
            <tr>
                <td>
                    <strong>Suma</strong>
                </td>
                <td>
                    <strong>@Model.Sum(e => e.Amount) zł</strong>
                </td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Brak wydatków. Dodaj pierwszy!</div>
    }
</div>